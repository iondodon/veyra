#!/usr/bin/env python3

"""Run the agent stored in the repository's checked-out Git commit."""

import fcntl
import json
import os
import signal
import shutil
import subprocess
import sys
import time
from pathlib import Path


POLL_INTERVAL_SECONDS = 0.25
RESTART_DELAY_SECONDS = 1.0
STOP_TIMEOUT_SECONDS = 5.0
LOCK_FILE_NAME = "supervisor.lock"
DASHBOARD_DIR_NAME = "web"
DASHBOARD_STATUS_FILE_NAME = "dashboard.json"
DASHBOARD_STATUS_INTERVAL_SECONDS = 5.0


class SupervisorError(RuntimeError):
    pass


def log(message: str) -> None:
    print(f"[supervisor] {message}", flush=True)


def repository_root() -> Path:
    return Path(__file__).resolve().parent.parent


def run_git(root: Path, *arguments: str) -> str:
    """Run a read-only Git query and return its normalized stdout."""
    try:
        result = subprocess.run(
            ["git", "-C", str(root), *arguments],
            check=False,
            capture_output=True,
            text=True,
            encoding="utf-8",
            errors="backslashreplace",
        )
    except OSError as exc:
        raise SupervisorError(f"could not run Git: {exc}") from exc

    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip()
        raise SupervisorError(detail or "Git query failed")

    return result.stdout.strip()


def current_revision(root: Path) -> str:
    return run_git(root, "rev-parse", "--verify", "HEAD")


def short_revision(revision: str) -> str:
    return revision[:12]


def read_lock_holder(descriptor: int) -> str:
    """Read the process ID recorded by the supervisor holding the lock."""
    try:
        os.lseek(descriptor, 0, os.SEEK_SET)
        recorded = os.read(descriptor, 32).decode("utf-8", "replace").strip()
    except OSError:
        return ""
    return recorded if recorded.isdigit() else ""


def acquire_single_instance_lock(root: Path) -> int:
    """Allow only one supervisor per repository.

    Two supervisors mean two agents polling the same Telegram bot token.
    Telegram serves a single getUpdates consumer and answers the rest
    with 409 Conflict, so two pollers that keep retrying starve each
    other and neither receives a message. Refuse the second start
    instead of failing silently.

    The returned descriptor must stay open for as long as the supervisor
    runs; the kernel releases the lock when the process exits.
    """
    state = root / "state"
    path = state / LOCK_FILE_NAME

    try:
        state.mkdir(parents=True, exist_ok=True)
        descriptor = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    except OSError as exc:
        raise SupervisorError(f"could not open {path}: {exc}") from exc

    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        holder = read_lock_holder(descriptor)
        os.close(descriptor)
        raise SupervisorError(
            "another supervisor is already running for this repository"
            + (f" (pid {holder})" if holder else "")
            + "; stop it before starting a new one"
        ) from None

    os.ftruncate(descriptor, 0)
    os.write(descriptor, f"{os.getpid()}\n".encode())
    return descriptor


def validate_agent(root: Path) -> Path:
    """Validate the fixed agent location without following a directory link."""
    agent = root / "agent"

    if agent.is_symlink():
        raise SupervisorError(f"agent must be a real directory: {agent}")
    if not agent.is_dir():
        raise SupervisorError(f"agent directory does not exist: {agent}")

    start = agent / "START"
    if not start.is_file():
        raise SupervisorError(f"agent has no START file: {start}")
    if not os.access(start, os.X_OK):
        raise SupervisorError(f"START is not executable: {start}")

    return agent


def agent_changes(root: Path) -> list[str]:
    output = run_git(
        root,
        "status",
        "--porcelain=v1",
        "--untracked-files=all",
        "--",
        "agent",
    )
    return output.splitlines() if output else []


def require_committed_agent(root: Path) -> None:
    """Refuse to call an uncommitted working tree a version."""
    try:
        run_git(root, "ls-files", "--error-unmatch", "agent/START")
    except SupervisorError as exc:
        raise SupervisorError("agent/START is not tracked by Git") from exc

    if agent_changes(root):
        raise SupervisorError(
            "agent has uncommitted changes; commit or discard them first"
        )


def run_self_test(agent: Path, revision: str) -> bool:
    start = agent / "START"
    label = short_revision(revision)
    log(f"self-testing agent at {label}")

    try:
        result = subprocess.run([str(start), "--self-test"], cwd=agent, check=False)
    except OSError as exc:
        log(f"self-test could not start at {label}: {exc}")
        return False

    if result.returncode != 0:
        log(f"self-test failed at {label} with exit code {result.returncode}")
        return False

    log(f"self-test passed at {label}")
    return True


def start_agent(agent: Path, revision: str) -> subprocess.Popen:
    log(f"starting agent at {short_revision(revision)}")
    return subprocess.Popen(
        [str(agent / "START")],
        cwd=agent,
        start_new_session=True,
    )


def start_dashboard(root: Path) -> subprocess.Popen | None:
    """Start the instance-local dashboard when this Veyra has one.

    The dashboard is deliberately optional: initial Veyra clones do not carry
    it, while evolved local instances may keep one outside versioned source.
    Its process is owned by the supervisor so it cannot outlive Veyra.
    """
    dashboard = root / DASHBOARD_DIR_NAME
    package = dashboard / "package.json"

    if not package.is_file():
        return None

    npm = shutil.which("npm")
    if npm is None:
        log("dashboard is available but npm is not installed; not starting it")
        return None

    log("starting private dashboard")
    try:
        return subprocess.Popen(
            [npm, "run", "dev"],
            cwd=dashboard,
            start_new_session=True,
        )
    except OSError as exc:
        log(f"dashboard could not start: {exc}")
        return None


def read_json_object(path: Path) -> dict:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}
    return value if isinstance(value, dict) else {}


def recent_versions(root: Path, limit: int = 8) -> list[dict[str, str]]:
    try:
        output = run_git(
            root,
            "log",
            f"-{limit}",
            "--format=%h%x1f%s%x1f%cI",
        )
    except SupervisorError:
        return []

    versions = []
    for line in output.splitlines():
        parts = line.split("\x1f", 2)
        if len(parts) != 3:
            continue
        commit, message, committed_at = parts
        versions.append({
            "commit": commit,
            "message": message,
            "committed_at": committed_at,
        })
    return versions


def revision_details(root: Path, revision: str) -> dict[str, str] | None:
    try:
        output = run_git(
            root,
            "show",
            "-s",
            "--format=%s%x1f%cI",
            revision,
        )
    except SupervisorError:
        return None

    parts = output.split("\x1f", 1)
    if len(parts) != 2:
        return None
    return {"message": parts[0], "committed_at": parts[1]}


def dashboard_status(
    root: Path,
    revision: str,
    process: subprocess.Popen,
    state: str,
) -> dict:
    memory = root / "state" / "memory"
    provider_data = read_json_object(memory / "provider.json")
    models_data = read_json_object(memory / "models.json")
    conversation_data = read_json_object(memory / "recent_messages.json")

    provider = provider_data.get("provider")
    if not isinstance(provider, str):
        provider = None

    model = models_data.get(provider) if provider else None
    if not isinstance(model, str):
        model = None

    messages = conversation_data.get("messages")
    message_count = len(messages) if isinstance(messages, list) else 0

    try:
        branch = run_git(root, "branch", "--show-current") or "detached"
    except SupervisorError:
        branch = "unknown"

    versions = recent_versions(root)
    current = revision_details(root, revision)
    is_running = state == "running" and process.poll() is None

    return {
        "schema_version": 1,
        "updated_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "agent": {
            "state": "running" if is_running else state,
            "pid": process.pid if is_running else None,
        },
        "revision": {
            "commit": revision,
            "short": short_revision(revision),
            "branch": branch,
            "message": current["message"] if current else "",
            "committed_at": current["committed_at"] if current else None,
        },
        "runtime": {
            "provider": provider,
            "model": model,
            "recent_message_count": message_count,
        },
        "versions": versions,
    }


def write_dashboard_status(
    root: Path,
    revision: str,
    process: subprocess.Popen,
    state: str,
) -> None:
    dashboard = root / DASHBOARD_DIR_NAME
    if not (dashboard / "package.json").is_file():
        return

    state_directory = root / "state"
    path = state_directory / DASHBOARD_STATUS_FILE_NAME
    temporary = state_directory / f".{DASHBOARD_STATUS_FILE_NAME}.tmp"

    try:
        state_directory.mkdir(parents=True, exist_ok=True)
        temporary.write_text(
            json.dumps(
                dashboard_status(root, revision, process, state),
                indent=2,
                sort_keys=True,
            )
            + "\n",
            encoding="utf-8",
        )
        os.replace(temporary, path)
    except OSError as exc:
        log(f"could not update dashboard status: {exc}")


def stop_dashboard(process: subprocess.Popen | None) -> None:
    if process is None:
        return
    log("stopping private dashboard")
    stop_agent(process)


def stop_agent(process: subprocess.Popen) -> None:
    if process.poll() is not None:
        return

    log(f"stopping pid {process.pid}")
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        return

    deadline = time.monotonic() + STOP_TIMEOUT_SECONDS
    while process.poll() is None and time.monotonic() < deadline:
        time.sleep(0.05)

    if process.poll() is not None:
        return

    log(f"pid {process.pid} did not stop; killing it")
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        return

    try:
        process.wait(timeout=1)
    except subprocess.TimeoutExpired:
        pass


def prepare_checked_out_agent(root: Path, revision: str) -> Path:
    agent = validate_agent(root)
    require_committed_agent(root)
    if not run_self_test(agent, revision):
        raise SupervisorError(
            f"agent at {short_revision(revision)} failed its self-test"
        )
    return agent


def main() -> int:
    root = repository_root()

    try:
        lock = acquire_single_instance_lock(root)
        active_revision = current_revision(root)
        agent = prepare_checked_out_agent(root, active_revision)
    except SupervisorError as exc:
        log(f"startup failed: {exc}")
        return 1

    process = start_agent(agent, active_revision)
    write_dashboard_status(root, active_revision, process, "running")
    dashboard = start_dashboard(root)
    last_dashboard_status_update = time.monotonic()
    shutting_down = False
    last_rejection: tuple[str, str] | None = None

    def request_shutdown(signum, _frame) -> None:
        nonlocal shutting_down
        log(f"received signal {signum}; shutting down")
        shutting_down = True

    signal.signal(signal.SIGINT, request_shutdown)
    signal.signal(signal.SIGTERM, request_shutdown)

    try:
        while not shutting_down:
            try:
                requested_revision = current_revision(root)
            except SupervisorError as exc:
                log(f"could not read HEAD: {exc}")
                return 1

            if requested_revision != active_revision:
                try:
                    candidate = prepare_checked_out_agent(root, requested_revision)
                except SupervisorError as exc:
                    rejection = (requested_revision, str(exc))
                    if rejection != last_rejection:
                        log(
                            f"not switching to {short_revision(requested_revision)}: "
                            f"{exc}"
                        )
                        last_rejection = rejection
                else:
                    log(
                        "commit switch detected: "
                        f"{short_revision(active_revision)} -> "
                        f"{short_revision(requested_revision)}"
                    )
                    write_dashboard_status(
                        root, active_revision, process, "restarting"
                    )
                    stop_agent(process)
                    agent = candidate
                    active_revision = requested_revision
                    last_rejection = None
                    process = start_agent(agent, active_revision)
                    write_dashboard_status(
                        root, active_revision, process, "running"
                    )
                    continue

            if process.poll() is not None:
                code = process.returncode
                write_dashboard_status(
                    root, active_revision, process, "restarting"
                )
                if requested_revision != active_revision or agent_changes(root):
                    log(
                        f"agent at {short_revision(active_revision)} exited with "
                        f"code {code}, but its committed files are no longer "
                        "checked out; select a working commit and restart"
                    )
                    return 1

                log(
                    f"agent at {short_revision(active_revision)} exited with "
                    f"code {code}; restarting in {RESTART_DELAY_SECONDS:g}s"
                )
                time.sleep(RESTART_DELAY_SECONDS)
                if shutting_down:
                    break
                process = start_agent(agent, active_revision)
                write_dashboard_status(
                    root, active_revision, process, "running"
                )
                continue

            if dashboard is not None and dashboard.poll() is not None:
                code = dashboard.returncode
                log(
                    f"private dashboard exited with code {code}; restarting in "
                    f"{RESTART_DELAY_SECONDS:g}s"
                )
                time.sleep(RESTART_DELAY_SECONDS)
                if shutting_down:
                    break
                dashboard = start_dashboard(root)

            now = time.monotonic()
            if now - last_dashboard_status_update >= DASHBOARD_STATUS_INTERVAL_SECONDS:
                write_dashboard_status(root, active_revision, process, "running")
                last_dashboard_status_update = now

            time.sleep(POLL_INTERVAL_SECONDS)
    finally:
        write_dashboard_status(root, active_revision, process, "stopped")
        stop_dashboard(dashboard)
        stop_agent(process)
        os.close(lock)

    return 0


if __name__ == "__main__":
    sys.exit(main())
