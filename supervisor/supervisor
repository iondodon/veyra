#!/usr/bin/env python3

"""Run the agent stored in the repository's checked-out Git commit."""

import fcntl
import os
import secrets
import signal
import subprocess
import sys
import time
from pathlib import Path
import traceback

sys.path.insert(0, str(Path(__file__).resolve().parent))
from web_gateway import WebGateway, WEB_URL
from recovery import RecoveryError


POLL_INTERVAL_SECONDS = 0.25
RESTART_DELAY_SECONDS = 1.0
STOP_TIMEOUT_SECONDS = 5.0
LOCK_FILE_NAME = "supervisor.lock"
CHAT = None


class SupervisorError(RuntimeError):
    pass


def log(message: str, *, error=False) -> None:
    if CHAT is not None:
        CHAT.publish(message, kind="error" if error else "status")


def repository_root() -> Path:
    return Path(__file__).resolve().parent.parent


def run_git(root: Path, *arguments: str) -> str:
    """Run a read-only Git query and return its normalized stdout."""
    try:
        result = subprocess.run(
            ["git", "-C", str(root), *arguments],
            check=False,
            capture_output=True,
            text=True,
            encoding="utf-8",
            errors="backslashreplace",
        )
    except OSError as exc:
        raise SupervisorError(f"could not run Git: {exc}") from exc

    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip()
        raise SupervisorError(detail or "Git query failed")

    return result.stdout.strip()


def current_revision(root: Path) -> str:
    return run_git(root, "rev-parse", "--verify", "HEAD")


def short_revision(revision: str) -> str:
    return revision[:12]


def read_lock_holder(descriptor: int) -> str:
    """Read the process ID recorded by the supervisor holding the lock."""
    try:
        os.lseek(descriptor, 0, os.SEEK_SET)
        recorded = os.read(descriptor, 32).decode("utf-8", "replace").strip()
    except OSError:
        return ""
    return recorded if recorded.isdigit() else ""


def acquire_single_instance_lock(root: Path) -> int:
    """Allow only one supervisor per repository.

    Refuse duplicate agents competing for the same state and web chat.

    The returned descriptor must stay open for as long as the supervisor
    runs; the kernel releases the lock when the process exits.
    """
    state = root / "state"
    path = state / LOCK_FILE_NAME

    try:
        state.mkdir(parents=True, exist_ok=True)
        descriptor = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    except OSError as exc:
        raise SupervisorError(f"could not open {path}: {exc}") from exc

    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        holder = read_lock_holder(descriptor)
        os.close(descriptor)
        raise SupervisorError(
            "another supervisor is already running for this repository"
            + (f" (pid {holder})" if holder else "")
            + "; stop it before starting a new one"
        ) from None

    os.ftruncate(descriptor, 0)
    os.write(descriptor, f"{os.getpid()}\n".encode())
    return descriptor


def validate_agent(root: Path) -> Path:
    """Validate the fixed agent location without following a directory link."""
    agent = root / "agent"

    if agent.is_symlink():
        raise SupervisorError(f"agent must be a real directory: {agent}")
    if not agent.is_dir():
        raise SupervisorError(f"agent directory does not exist: {agent}")

    start = agent / "START"
    if not start.is_file():
        raise SupervisorError(f"agent has no START file: {start}")
    if not os.access(start, os.X_OK):
        raise SupervisorError(f"START is not executable: {start}")

    return agent


def agent_changes(root: Path) -> list[str]:
    output = run_git(
        root,
        "status",
        "--porcelain=v1",
        "--untracked-files=all",
        "--",
        "agent",
    )
    return output.splitlines() if output else []


def require_committed_agent(root: Path) -> None:
    """Refuse to call an uncommitted working tree a version."""
    try:
        run_git(root, "ls-files", "--error-unmatch", "agent/START")
    except SupervisorError as exc:
        raise SupervisorError("agent/START is not tracked by Git") from exc

    if agent_changes(root):
        raise SupervisorError(
            "agent has uncommitted changes; commit or discard them first"
        )


def run_self_test(agent: Path, revision: str) -> bool:
    start = agent / "START"
    label = short_revision(revision)
    log(f"self-testing agent at {label}")

    try:
        result = subprocess.run(
            [str(start), "--self-test"], cwd=agent, check=False,
            capture_output=True, text=True, encoding="utf-8", errors="backslashreplace",
            timeout=120,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        log(f"Veyra couldn't check its next version: {exc}", error=True)
        return False

    for line in (result.stdout + result.stderr).splitlines():
        if line.strip():
            log(line)
    if result.returncode != 0:
        log("Veyra couldn't start that version because its self-test failed.", error=True)
        return False

    log(f"self-test passed at {label}")
    return True


def start_agent(agent: Path, revision: str) -> subprocess.Popen:
    log(f"starting agent at {short_revision(revision)}")
    directory = agent.parent / "state/run"
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    directory.chmod(0o700)
    socket_path = directory / "agent.sock"
    socket_path.unlink(missing_ok=True)
    token = secrets.token_urlsafe(32)
    process = subprocess.Popen(
        [str(agent / "START")],
        cwd=agent,
        start_new_session=True,
        env={**os.environ, "VEYRA_WEB_TRANSPORT": "1", "VEYRA_AGENT_SOCKET": str(socket_path),
             "VEYRA_AGENT_TOKEN": token},
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        encoding="utf-8",
        errors="backslashreplace",
        bufsize=1,
    )
    process.socket_path = socket_path
    process.web_token = token
    return process


def stop_agent(process: subprocess.Popen) -> None:
    if process.poll() is not None:
        return

    log(f"stopping pid {process.pid}")
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        return

    deadline = time.monotonic() + STOP_TIMEOUT_SECONDS
    while process.poll() is None and time.monotonic() < deadline:
        time.sleep(0.05)

    if process.poll() is not None:
        return

    log(f"pid {process.pid} did not stop; killing it")
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        return

    try:
        process.wait(timeout=1)
    except subprocess.TimeoutExpired:
        pass


def prepare_checked_out_agent(root: Path, revision: str) -> Path:
    agent = validate_agent(root)
    require_committed_agent(root)
    if not run_self_test(agent, revision):
        raise SupervisorError(
            f"agent at {short_revision(revision)} failed its self-test"
        )
    if current_revision(root) != revision:
        raise SupervisorError("the checked-out commit changed during its startup check; retrying the new version")
    require_committed_agent(root)
    return agent


def main() -> int:
    global CHAT
    root = repository_root()
    CHAT = WebGateway(root)
    print(f"Open Veyra at {WEB_URL}", flush=True)
    try:
        lock = acquire_single_instance_lock(root)
    except SupervisorError as exc:
        log(f"Veyra couldn't start: {exc}", error=True)
        return 1
    try:
        CHAT.start()
    except OSError as exc:
        log(f"Could not open the web chat on port 3000: {exc}", error=True)
        os.close(lock)
        return 1
    process = None
    active_revision = None
    shutting_down = False
    last_rejection = None

    def request_shutdown(signum, _frame) -> None:
        nonlocal shutting_down
        log(f"received signal {signum}; shutting down")
        shutting_down = True

    signal.signal(signal.SIGINT, request_shutdown)
    signal.signal(signal.SIGTERM, request_shutdown)

    try:
        while not shutting_down:
            job = CHAT.recovery.take_request()
            if job:
                CHAT.detach()
                if process is not None:
                    stop_agent(process)
                process = None
                active_revision = None
                try:
                    CHAT.recovery.execute(job)
                    last_rejection = None
                except (RecoveryError, OSError, subprocess.TimeoutExpired) as exc:
                    log(f"Recovery couldn't finish: {exc}", error=True)
                    last_rejection = (current_revision(root), tuple(agent_changes(root)))
                finally:
                    CHAT.recovery.busy = False
            try:
                requested_revision = current_revision(root)
            except SupervisorError as exc:
                log(f"Veyra couldn't read its current version: {exc}", error=True)
                time.sleep(POLL_INTERVAL_SECONDS)
                continue

            if process is None or requested_revision != active_revision:
                # Retry a rejected candidate only when its commit or working tree changes.
                # The web page remains available for recovery messages.
                candidate_key = (requested_revision, tuple(agent_changes(root)))
                if candidate_key != last_rejection:
                    CHAT.recovery.busy = True
                    try:
                        candidate = prepare_checked_out_agent(root, requested_revision)
                    except SupervisorError as exc:
                        log(f"Veyra couldn't start its next version: {exc}", error=True)
                        last_rejection = candidate_key
                    else:
                        if process is not None:
                            log(f"Activating commit {short_revision(requested_revision)}.")
                            CHAT.detach()
                            stop_agent(process)
                        agent = candidate
                        active_revision = requested_revision
                        last_rejection = None
                        try:
                            process = start_agent(agent, active_revision)
                        except OSError as exc:
                            log(f"Veyra couldn't launch its agent: {exc}", error=True)
                            process = None
                            active_revision = None
                            last_rejection = candidate_key
                            continue
                        CHAT.attach(process, active_revision)
                        CHAT.recovery.error = None
                        CHAT.recovery.busy = False
                        continue
                    finally:
                        CHAT.recovery.busy = False

            if process is not None and process.poll() is not None:
                code = process.returncode
                CHAT.detach()
                if requested_revision != active_revision or agent_changes(root):
                    log(
                        f"agent at {short_revision(active_revision)} exited with "
                        f"code {code}, but its committed files are no longer "
                        "checked out; select a working commit and restart", error=True,
                    )
                    process = None
                    active_revision = None
                    continue

                log(
                    f"agent at {short_revision(active_revision)} exited with "
                    f"code {code}; restarting in {RESTART_DELAY_SECONDS:g}s", error=True,
                )
                time.sleep(RESTART_DELAY_SECONDS)
                if shutting_down:
                    break
                try:
                    process = start_agent(agent, active_revision)
                except OSError as exc:
                    log(f"Veyra couldn't relaunch its agent: {exc}", error=True)
                    process = None
                    active_revision = None
                    last_rejection = (requested_revision, tuple(agent_changes(root)))
                    continue
                CHAT.attach(process, active_revision)
                continue

            if process is not None and CHAT.ready():
                CHAT.recovery.mark_working(active_revision)

            time.sleep(POLL_INTERVAL_SECONDS)
    finally:
        CHAT.detach()
        if process is not None:
            stop_agent(process)
        CHAT.close()
        os.close(lock)

    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
    except Exception:
        if CHAT is not None:
            CHAT.publish("Veyra stopped unexpectedly:\n" + traceback.format_exc())
        sys.exit(1)
