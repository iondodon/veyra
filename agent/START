#!/bin/sh
set -eu

AGENT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT_DIR="$(CDPATH= cd -- "$AGENT_DIR/.." && pwd)"

# Normal launches use the supervisor, which owns the quiet web interface.
case "${1:-}" in
    --self-test|--chatgpt-*) ;;
    *)
        if [ "${VEYRA_WEB_TRANSPORT:-}" != "1" ]; then
            exec python3 "$ROOT_DIR/supervisor/supervisor"
        fi
        ;;
esac

VENV="$ROOT_DIR/.venv"
PYTHON="$VENV/bin/python"


# ------------------------------------------------------------
# Bootstrap the agent's Python environment
# ------------------------------------------------------------

if [ ! -x "$PYTHON" ]; then
    echo "[agent] Preparing runtime..."

    if ! command -v python3 >/dev/null 2>&1; then
        echo "[agent] Python 3 is required." >&2
        exit 2
    fi

    if ! python3 -m venv "$VENV"; then
        echo "[agent] Could not create the Python environment." >&2
        exit 2
    fi
fi

# Update an existing environment when a successor changes dependencies.
REQUIREMENTS_HASH="$("$PYTHON" -c 'import hashlib,sys; print(hashlib.sha256(open(sys.argv[1], "rb").read()).hexdigest())' "$AGENT_DIR/requirements.txt")"
INSTALLED_HASH="$(cat "$VENV/.requirements-hash" 2>/dev/null || true)"
if [ "$REQUIREMENTS_HASH" != "$INSTALLED_HASH" ]; then
    "$PYTHON" -m pip install --disable-pip-version-check --quiet -r "$AGENT_DIR/requirements.txt"
    printf '%s\n' "$REQUIREMENTS_HASH" > "$VENV/.requirements-hash"
    echo "[agent] Runtime ready."
fi


# ------------------------------------------------------------
# Start the agent from the checked-out commit
# ------------------------------------------------------------

exec "$PYTHON" "$AGENT_DIR/bootstrap.py" "$@"
