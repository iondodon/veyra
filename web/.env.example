# Trusted origin used to generate absolute social-preview metadata.
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000

# Optional: open your specific Veyra bot instead of Telegram's web client.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Live desktop capture: 12 fps by default (1–15), only while watching.
# This is a silent JPEG frame stream, not an audio/video recording.
VEYRA_SCREEN_FPS=12
VEYRA_SCREEN_QUALITY=70
VEYRA_SCREEN_SCALE=0.75
